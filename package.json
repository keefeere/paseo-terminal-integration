  "license": "MIT",
  "author": "Chechulin Serhii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keefeere/paseo-terminal-integration.git"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
